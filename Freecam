LocalPlayer.CharacterAdded:Connect(function(char)
	FreeCamActive   = false
	IsTransitioning = false

	for k, c in pairs(Connections) do
		if c then c:Disconnect() end
		Connections[k] = nil
	end

	if FreeCamPart and FreeCamPart.Parent then
		FreeCamPart:Destroy()
	end
	FreeCamPart = nil

	roll       = 0
	pitch, yaw = 0, 0
	RMBHeld    = false

	FreeCamBtn.Visible    = true
	ExitBtn.Visible       = false
	EyeBtn.Visible        = false
	SettingsBtn.Visible   = false
	LightingPanel.Visible = false
	DPad.Visible          = false
	VertFrame.Visible     = false
	TiltFrame.Visible     = false
	ZoomFrame.Visible     = false

	removeCinematicEffects()
	setCoreUI(true)
	restoreAllScreenGuis()
	setOverheadsVisible(true)
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default

	Character  = char
	HumanoidRP = char:WaitForChild("HumanoidRootPart")
	Humanoid   = char:WaitForChild("Humanoid")

	Camera.CameraType    = Enum.CameraType.Custom
	Camera.CameraSubject = Humanoid
end)
