	local togBtn = Instance.new("TextButton")
	togBtn.Size = UDim2.new(0, 46, 0, 24)
	togBtn.AnchorPoint = Vector2.new(1, 0.5)
	togBtn.Position = UDim2.new(1, 0, 0.5, 0)
	togBtn.BackgroundColor3 = default and THEME.ACCENT or Color3.fromRGB(45, 45, 50)
	togBtn.BorderSizePixel = 0
	togBtn.Text = default and "ON" or "OFF"
	togBtn.TextColor3 = THEME.FG
	togBtn.TextSize = 11
	togBtn.Font = Enum.Font.MontserratBold
	togBtn.ZIndex = 16
	togBtn.Parent = container
