	local p = Instance.new("Part")
	p.Name         = "FreeCamPart"
	p.Size         = Vector3.new(0.1, 0.1, 0.1)
	p.Anchored     = true
	p.CanCollide   = false
	p.Transparency = 1
	p.CastShadow   = false
	p.CFrame       = Camera.CFrame
	p.Parent       = workspace
	return p
end

local function setCharacterFrozen(frozen)
	local char = LocalPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end

	if frozen then
		OriginalRootAnchored  = hrp.Anchored
		OriginalRootCollision = hrp.CanCollide
		hum.WalkSpeed         = 0
		hum.JumpHeight        = 0
		hrp.Anchored          = true
		hrp.CanCollide        = false
		hum.AutoRotate        = false
	else
		hum.WalkSpeed  = 16
		hum.JumpHeight = 7.2
		hrp.Anchored   = OriginalRootAnchored
		hrp.CanCollide = OriginalRootCollision
		hum.AutoRotate = true
	end
end

local function initAngles(cf)
	local lv = cf.LookVector
	pitch = math.asin(math.clamp(lv.Y, -1, 1))
	yaw   = math.atan2(-lv.X, -lv.Z)
	roll  = 0
	targetFov = Camera.FieldOfView
	currentFov = Camera.FieldOfView
	currentVelocity = Vector3.new(0, 0, 0)
end

local function getMovementVector()
	local move = Vector3.zero
	if not isMobileDevice() then
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += Vector3.new( 0, 0,-1) end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then move += Vector3.new( 0, 0, 1) end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then move += Vector3.new(-1, 0, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += Vector3.new( 1, 0, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.E) then move += Vector3.new( 0, 1, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.Q) then move += Vector3.new( 0,-1, 0) end
	else
		if MobileInput.Forward then move += Vector3.new( 0, 0,-1) end
		if MobileInput.Back    then move += Vector3.new( 0, 0, 1) end
		if MobileInput.Left    then move += Vector3.new(-1, 0, 0) end
		if MobileInput.Right   then move += Vector3.new( 1, 0, 0) end
		if MobileInput.Up      then move += Vector3.new( 0, 1, 0) end
		if MobileInput.Down    then move += Vector3.new( 0,-1, 0) end
	end
	return move.Magnitude > 0 and move.Unit or move
end

local TILT_MAX_RAD   = math.rad(CONFIG.TiltMax)
local TILT_SPEED_RAD = math.rad(CONFIG.TiltSpeed)

local function freecamUpdate(dt)
	if not FreeCamActive or not FreeCamPart then return end

	if not isMobileDevice() then
		if UserInputService:IsKeyDown(Enum.KeyCode.I) then
			targetFov = math.clamp(targetFov - CONFIG.ZoomSpeed, CONFIG.MinFOV, CONFIG.MaxFOV)
		elseif UserInputService:IsKeyDown(Enum.KeyCode.O) then
			targetFov = math.clamp(targetFov + CONFIG.ZoomSpeed, CONFIG.MinFOV, CONFIG.MaxFOV)
		end
	else
		if MobileInput.ZoomIn then
			targetFov = math.clamp(targetFov - CONFIG.ZoomSpeed, CONFIG.MinFOV, CONFIG.MaxFOV)
		elseif MobileInput.ZoomOut then
			targetFov = math.clamp(targetFov + CONFIG.ZoomSpeed, CONFIG.MinFOV, CONFIG.MaxFOV)
		end
	end

	currentFov = currentFov + (targetFov - currentFov) * (dt * 10)
	Camera.FieldOfView = currentFov

	local tiltLeft  = (not isMobileDevice() and UserInputService:IsKeyDown(Enum.KeyCode.Z)) or MobileInput.TiltLeft
	local tiltRight = (not isMobileDevice() and UserInputService:IsKeyDown(Enum.KeyCode.C)) or MobileInput.TiltRight

	if tiltLeft and not tiltRight then
		roll = math.clamp(roll - TILT_SPEED_RAD * (dt / (1/60)), -TILT_MAX_RAD, TILT_MAX_RAD)
	elseif tiltRight and not tiltLeft then
		roll = math.clamp(roll + TILT_SPEED_RAD * (dt / (1/60)), -TILT_MAX_RAD, TILT_MAX_RAD)
	end

	local sprint = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
	local speed  = sprint and CONFIG.SprintSpeed or CONFIG.Speed
	if isMobileDevice() then speed *= CONFIG.MobileSpeed end

	local moveVec = getMovementVector()
	local cf      = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
	local targetVelocity = cf:VectorToWorldSpace(moveVec) * speed

	currentVelocity = currentVelocity:Lerp(targetVelocity, CONFIG.Smoothness)
	FreeCamPart.CFrame = FreeCamPart.CFrame + (currentVelocity * dt)

	Camera.CFrame = CFrame.new(FreeCamPart.Position)
		* CFrame.Angles(0, yaw, 0)
		* CFrame.Angles(pitch, 0, 0)
		* CFrame.Angles(0, 0, roll)
	Camera.CameraType = Enum.CameraType.Scriptable
end

-- ─── Activate / Deactivate ───────────────────────────────────────────────────

local deactivateFreeCam

local function activateFreeCam()
	if FreeCamActive or IsTransitioning then return end
	IsTransitioning = true
	FreeCamActive   = true

	initAngles(Camera.CFrame)
	FreeCamPart = createFreeCamPart()

	setCoreUI(false)
	hideAllScreenGuis()
	setOverheadsVisible(false)
	setCharacterFrozen(true)
	setupCinematicEffects()

	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	RMBHeld = false

	Camera.CameraType = Enum.CameraType.Scriptable

	UIHidden = false
	MenuOpen = false
	LightingPanel.Visible = false
	EyeBtn.Text = "👁"

	FreeCamBtn.Visible  = false
	ExitBtn.Visible     = true
	EyeBtn.Visible      = true
	SettingsBtn.Visible = true

	local showControls = not UIHidden and isMobileDevice()
	DPad.Visible      = showControls
	VertFrame.Visible = showControls
	TiltFrame.Visible = showControls
	ZoomFrame.Visible = showControls

	Connections.render = RunService.RenderStepped:Connect(freecamUpdate)

	Connections.mouseWheel = UserInputService.InputChanged:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseWheel then
			targetFov = math.clamp(targetFov - (inp.Position.Z * CONFIG.ZoomSpeed * 1.5), CONFIG.MinFOV, CONFIG.MaxFOV)
		end
	end)

	Connections.inputBegan = UserInputService.InputBegan:Connect(function(inp, gp)
		if gp then return end
		if inp.UserInputType == Enum.UserInputType.MouseButton2 then
			RMBHeld = true
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
		end
		if inp.KeyCode == Enum.KeyCode.X then
			deactivateFreeCam()
		end
	end)

	Connections.inputEnded = UserInputService.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton2 then
			RMBHeld = false
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
	end)

	Connections.mouseMoved = UserInputService.InputChanged:Connect(function(inp)
		if not FreeCamActive then return end
		if inp.UserInputType == Enum.UserInputType.MouseMovement and RMBHeld then
			yaw   = yaw - inp.Delta.X * CONFIG.Sensitivity
			pitch = math.clamp(
				pitch - inp.Delta.Y * CONFIG.Sensitivity,
				-math.pi/2 + 0.01, math.pi/2 - 0.01
			)
		end
	end)

	if isMobileDevice() then
		Connections.touchBegan = UserInputService.TouchStarted:Connect(function(inp, gp)
			if gp then return end
			if MobileLookId == nil then
				MobileLookId  = inp
				MobileLastPos = inp.Position
			end
		end)
		Connections.touchMoved = UserInputService.TouchMoved:Connect(function(inp, gp)
			if gp then return end
			if inp == MobileLookId and MobileLastPos then
				local delta = inp.Position - MobileLastPos
				MobileLastPos = inp.Position
				yaw   = yaw - delta.X * CONFIG.Sensitivity
				pitch = math.clamp(
					pitch - delta.Y * CONFIG.Sensitivity,
					-math.pi/2 + 0.01, math.pi/2 - 0.01
				)
			end
		end)
		Connections.touchEnded = UserInputService.TouchEnded:Connect(function(inp)
			if inp == MobileLookId then
				MobileLookId  = nil
				MobileLastPos = nil
			end
		end)
	end

	IsTransitioning = false
end

deactivateFreeCam = function()
	if not FreeCamActive or IsTransitioning then return end
	IsTransitioning = true
	FreeCamActive   = false

	for k, c in pairs(Connections) do
		if c then c:Disconnect() end
		Connections[k] = nil
	end

	if FreeCamPart and FreeCamPart.Parent then FreeCamPart:Destroy() end
	FreeCamPart = nil

	RMBHeld = false
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default

	MobileLookId  = nil
	MobileLastPos = nil
	for k in pairs(MobileInput) do MobileInput[k] = false end

	roll = 0
	Camera.FieldOfView = 70

	FreeCamBtn.Visible    = true
	ExitBtn.Visible       = false
	EyeBtn.Visible        = false
	SettingsBtn.Visible   = false
	LightingPanel.Visible = false
	MenuOpen              = false

	DPad.Visible      = false
	VertFrame.Visible = false
	TiltFrame.Visible = false
	ZoomFrame.Visible = false

	removeCinematicEffects()
	setCoreUI(true)
	restoreAllScreenGuis()
	setOverheadsVisible(true)
	setCharacterFrozen(false)

	Camera.CameraType = Enum.CameraType.Custom
	local char = LocalPlayer.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then Camera.CameraSubject = hum end
	end

	IsTransitioning = false
end

FreeCamBtn.MouseButton1Click:Connect(function()
	if FreeCamActive then
		deactivateFreeCam()
	else
		activateFreeCam()
	end
end)

ExitBtn.MouseButton1Click:Connect(function()
	if not FreeCamActive then return end
	deactivateFreeCam()
end)

UserInputService.InputBegan:Connect(function(inp, gp)
	if gp then return end
	if inp.KeyCode == Enum.KeyCode.F2 then
		if FreeCamActive then
			deactivateFreeCam()
		else
			activateFreeCam()
		end
	end
end)

