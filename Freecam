local function setCoreUI(visible)
	for el, shouldHide in pairs(CORE_HIDE) do
		if shouldHide then
			pcall(function()
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType[el], visible)
			end)
		end
	end
end

-- ─── ScreenGui Hide / Restore ─────────────────────────────────────────────────

local function hideAllScreenGuis()
	local pg = LocalPlayer:WaitForChild("PlayerGui")
	for _, obj in ipairs(pg:GetChildren()) do
		if obj:IsA("ScreenGui") and obj.Name ~= "FreeCamOverlay" and obj.Enabled then
			obj.Enabled = false
			table.insert(HiddenGuis, obj)
		end
	end
end

local function restoreAllScreenGuis()
	for _, obj in ipairs(HiddenGuis) do
		if obj and obj.Parent then obj.Enabled = true end
	end
	HiddenGuis = {}
end

-- ─── Overhead / NameTag Hide ──────────────────────────────────────────────────

local function setOverheadsVisible(visible)
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		if char then
			local function checkAndSet(descendant)
				if descendant:IsA("BillboardGui") or descendant:IsA("SurfaceGui") then
					if descendant.Name ~= "FreeCamOverlay" then
						descendant.Enabled = visible
					end
				end
			end
			for _, descendant in ipairs(char:GetDescendants()) do
				checkAndSet(descendant)
			end
			char.DescendantAdded:Connect(function(descendant)
				if FreeCamActive then
					checkAndSet(descendant)
				end
			end)
		end
	end
end

-- ─── Setup Efek Cinematic Lighting Pro ────────────────────────────────────────

local function setupCinematicEffects()
	originalLighting.Brightness = Lighting.Brightness
	originalLighting.ExposureCompensation = Lighting.ExposureCompensation
	originalLighting.ClockTime = Lighting.ClockTime

	Lighting.ClockTime = 17.5 

	local bloom = Instance.new("BloomEffect")
	bloom.Name = "FreeCam_Bloom"
	bloom.Intensity = currentLightingSettings.BloomIntensity
	bloom.Size = 32
	bloom.Threshold = 0.8
	bloom.Parent = Lighting
	cinematicEffects.Bloom = bloom

	local dof = Instance.new("DepthOfFieldEffect")
	dof.Name = "FreeCam_DoF"
	dof.Enabled = currentLightingSettings.DoFEnabled
	dof.FocusDistance = currentLightingSettings.FocusDistance
	dof.InFocusRadius = 25
	dof.NearIntensity = 0.7
	dof.FarIntensity = 0.7
	dof.Parent = Lighting
	cinematicEffects.DepthOfField = dof

	local blur = Instance.new("BlurEffect")
	blur.Name = "FreeCam_Blur"
	blur.Size = currentLightingSettings.BlurSize
	blur.Parent = Lighting
	cinematicEffects.Blur = blur

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "FreeCam_CC"
	cc.Saturation = currentLightingSettings.Saturation
	cc.Contrast = currentLightingSettings.Contrast
	cc.TintColor = Color3.fromRGB(255, 245, 230)
	cc.Parent = Lighting
	cinematicEffects.ColorCorrection = cc

	local sunRays = Instance.new("SunRaysEffect")
	sunRays.Name = "FreeCam_SunRays"
	sunRays.Intensity = currentLightingSettings.SunIntensity
	sunRays.Spread = 0.5
	sunRays.Parent = Lighting
	cinematicEffects.SunRays = sunRays

	local atmos = Instance.new("Atmosphere")
	atmos.Name = "FreeCam_Atmosphere"
	atmos.Density = currentLightingSettings.AtmosphereDensity
	atmos.Offset = 0.25
	atmos.Color = Color3.fromRGB(200, 210, 230)
	atmos.Decay = Color3.fromRGB(80, 90, 110)
	atmos.Glare = 0.4
	atmos.Haze = 1.5
	atmos.Parent = Lighting
	cinematicEffects.Atmosphere = atmos
end

local function removeCinematicEffects()
	Lighting.Brightness = originalLighting.Brightness
	Lighting.ExposureCompensation = originalLighting.ExposureCompensation
	Lighting.ClockTime = originalLighting.ClockTime

	for _, eff in pairs(cinematicEffects) do
		if eff and eff.Parent then
			pcall(function() eff:Destroy() end)
		end
	end

	for _, child in ipairs(Lighting:GetChildren()) do
		if child.Name:sub(1, 8) == "FreeCam_" then
			pcall(function() child:Destroy() end)
		end
	end

	cinematicEffects = {Bloom = nil, DepthOfField = nil, Blur = nil, ColorCorrection = nil, SunRays = nil, Atmosphere = nil}
end

