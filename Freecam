		state = not state
		togBtn.BackgroundColor3 = state and THEME.ACCENT or Color3.fromRGB(45, 45, 50)
		togBtn.Text = state and "ON" or "OFF"
		callback(state)
	end)

	container.Parent = ScrollingOptions
end

