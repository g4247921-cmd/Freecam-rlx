	local lbl = Instance.new("ImageLabel")
	lbl.AnchorPoint            = Vector2.new(0.5, 0.5)
	lbl.Size                   = UDim2.new(1, 0, 1, 0)
	lbl.Position               = UDim2.new(0.5, 0, 0.5, 0)
	lbl.BackgroundTransparency = 1
	lbl.Image                  = "rbxassetid://86617453295561"
	lbl.ImageColor3            = THEME.ACCENT
	lbl.ScaleType              = Enum.ScaleType.Fit
	lbl.ZIndex                 = 11
	lbl.Parent                 = btn

	if flipX then lbl.Rotation = 180 end

	btn.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.Touch or inp.UserInputType == Enum.UserInputType.MouseButton1 then onState(true) end
	end)
	btn.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.Touch or inp.UserInputType == Enum.UserInputType.MouseButton1 then onState(false) end
	end)
	return btn
end

